{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/cia-lock.cjs\"",
            "timeout": 10,
            "statusMessage": "检查CIA锁定"
          }
        ]
      }
    ]
  }
}
